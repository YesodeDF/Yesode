{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "yesode.com.br" }],
      "destination": "https://yesode.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.yesode.com.br" }],
      "destination": "https://yesode.com/:path*",
      "permanent": true
    },
    {
      "source": "/en/tools/media-downloader",
      "destination": "/en/tools/youtube-social-video-downloader",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/tools/media-download",
      "destination": "/api/media-download"
    },
    {
      "source": "/api/tools/media-info",
      "destination": "/api/media-info"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
